# Mazi Idika — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-string

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.xxxx.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxx

# ── Meta WhatsApp Cloud API (preserved — existing integration) ────────────────
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
# From https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The WhatsApp-enabled number (sandbox: +14155238886, or your approved sender)
TWILIO_WHATSAPP_NUMBER=+14155238886
# Optional extra security: set any random string here and append ?token=<this>
# to your Twilio webhook URL in the Twilio console
TWILIO_WEBHOOK_SECRET=your-random-secret-string

# ── LLM ───────────────────────────────────────────────────────────────────────
# Primary: Gemini (best Nigerian language understanding, generous free tier)
GEMINI_API_KEY=your-gemini-api-key
# Fallback: OpenAI (also used for Whisper voice transcription)
OPENAI_API_KEY=sk-xxxx

# ── Voice (speech-to-text) ────────────────────────────────────────────────────
# Primary voice transcription — better Nigerian accent support than Whisper
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://mazi.ng"]
